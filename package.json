{
  "name": "sloplint",
  "version": "0.1.0",
  "description": "Detect the patterns that make a web UI look AI-generated, and fix them the way design systems do.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sloplint": "skills/sloplint/checker/cli.mjs"
  },
  "files": [
    "skills/",
    "integrations/",
    "README.md",
    "README.vi.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/",
    "scan:fixtures": "node skills/sloplint/checker/cli.mjs scan fixtures/slop-app.html fixtures/clean-app.html fixtures/slop-landing.html fixtures/clean-landing.html --out slop-report --hover"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "keywords": [
    "ai-slop",
    "design-system",
    "lint",
    "ui",
    "accessibility",
    "claude-code",
    "agent-skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callmehai/sloplint.git"
  },
  "homepage": "https://github.com/callmehai/sloplint#readme"
}
